{
  "name": "claudio-desktop",
  "productName": "Claudio",
  "version": "1.0.0",
  "description": "Claudio — asistente personal de voz para Windows",
  "author": "The DOM Studio Web",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.thedomstudio.claudio",
    "productName": "Claudio",
    "files": ["main.js", "preload.js", "www/**/*", "build/tray.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Claudio-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claudio"
    },
    "publish": null
  }
}
